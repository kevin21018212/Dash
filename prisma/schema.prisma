// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum State {
  BACKLOG
  IN_PROGRESS
  COMPLETED
}

// ----------------------
// GAMES
// ----------------------
model Game {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Shared fields
  title               String
  genre               String?
  tags                String[] @db.VarChar(250) // Postgres array example
  state               State
  image               String?
  completionPercentage Int?    // if state == IN_PROGRESS
  reviewScore         Int?     // if state == COMPLETED
  timesCompleted      Int?     // if state == COMPLETED

  // Games-specific
  isOneHundredPct     Boolean?
  isCasual            Boolean?
  platform            String?
}

// ----------------------
// MOVIES
// ----------------------
model Movie {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Shared fields
  title               String
  genre               String?
  tags                String[] @db.VarChar(250)
  state               State
  image               String?
  completionPercentage Int?
  reviewScore         Int?
  timesCompleted      Int?

  // Movies-specific
  watchOn             String?
  runtimeMinutes      Int?
}

